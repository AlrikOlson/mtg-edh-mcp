{
  "name": "mtg-edh-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Magic: The Gathering Commander/EDH deckbuilding.",
  "type": "module",
  "license": "MIT",
  "author": "Alrik Olson",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "magic-the-gathering",
    "mtg",
    "commander",
    "edh",
    "deckbuilding",
    "scryfall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlrikOlson/mtg-edh-mcp.git"
  },
  "homepage": "https://github.com/AlrikOlson/mtg-edh-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlrikOlson/mtg-edh-mcp/issues"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "mtg-edh-mcp": "dist/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs/INSTALL.md",
    "docs/AGENT-COOKBOOK.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "ingest": "node dist/ingest.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workflows": "vitest run src/server/workflowMetrics.test.ts src/server/workflowScenarios.test.ts src/server/workflowBaseline.test.ts",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "start": "node dist/main.js",
    "prepack": "npm run build",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "stream-chain": "^3.6.3",
    "stream-json": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "private": true,
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    }
  }
}
